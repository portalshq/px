{
  "name": "@portalshq/narrativeengine",
  "version": "0.9.0",
  "description": "Provider-driven TypeScript context and generation middleware for sequential narratives.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portalshq/px"
  },
  "homepage": "https://github.com/portalshq/px#readme",
  "bugs": {
    "url": "https://github.com/portalshq/px/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated": {
      "types": "./dist/generated/narrative/v1/narrative.d.ts",
      "default": "./dist/generated/narrative/v1/narrative.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "protoc -I ../../proto --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated --ts_proto_opt=onlyTypes=true,outputServices=none,esModuleInterop=true,useOptionals=messages ../../proto/narrative/v1/narrative.proto",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:types": "tsc -p tsconfig.json",
    "build": "npm run clean && npm run build:types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "ts-proto": "^2.12.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
